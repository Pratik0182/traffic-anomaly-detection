# Kafka: use a routable private IP/hostname for remote machines, never remote localhost.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=website_traffic
KAFKA_CLIENT_ID=website-traffic-generator
KAFKA_STARTING_OFFSETS=latest

# Traffic generator
GENERATOR_RATE=5
GENERATOR_SEED=

# Spark Structured Streaming
SPARK_APP_NAME=WebsiteTrafficStreaming
SPARK_LOG_LEVEL=WARN
SPARK_SQL_SHUFFLE_PARTITIONS=4
SPARK_TRIGGER_INTERVAL=10 seconds
METRIC_WINDOW_DURATION=1 minute
METRIC_WATERMARK_DELAY=2 minutes
APPROX_COUNT_DISTINCT_RSD=0.05
SPIKE_THRESHOLD_REQUESTS_PER_MINUTE=600

# Single-machine defaults. Replace with hdfs://master:9000/... in cluster mode.
HDFS_RAW_EVENTS_PATH=file:///tmp/website-traffic/raw/events
STREAMING_CHECKPOINT_BASE=file:///tmp/website-traffic/checkpoints

# HBase Thrift service (normally started on the master at port 9090).
HBASE_THRIFT_HOST=localhost
HBASE_THRIFT_PORT=9090
HBASE_THRIFT_TIMEOUT_MS=10000
HBASE_METRICS_TABLE=traffic_metrics
HBASE_ALERTS_TABLE=traffic_spike_alerts

# Spark batch report output, read by Streamlit through `hdfs dfs -cat`.
HDFS_REPORTS_PATH=file:///tmp/website-traffic/reports
