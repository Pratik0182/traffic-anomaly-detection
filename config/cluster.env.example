# Copy to config/cluster.env and replace all sample values before running configure_node.sh.
# These hostnames are added to /etc/hosts and must resolve to private IPv4 addresses (Tailscale or RFC1918 LAN).

MASTER_HOST=master
WORKER1_HOST=worker1
WORKER2_HOST=worker2

MASTER_TAILSCALE_IP=REPLACE_WITH_MASTER_TAILSCALE_IP
WORKER1_TAILSCALE_IP=REPLACE_WITH_WORKER1_TAILSCALE_IP
WORKER2_TAILSCALE_IP=REPLACE_WITH_WORKER2_TAILSCALE_IP

# Persistent local data directory on each Ubuntu VM.
DATA_ROOT=/data/bigdata

# HDFS has two DataNodes (worker1 and worker2), so replication must not exceed 2.
HDFS_REPLICATION=2

# Keep memory modest on 16 GB Windows hosts running Ubuntu VMs.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_MAX_CORES=4

# Kafka uses a 3-node KRaft controller quorum and 3 brokers.
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_TOPIC=website_traffic
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=3
KAFKA_MIN_INSYNC_REPLICAS=2
